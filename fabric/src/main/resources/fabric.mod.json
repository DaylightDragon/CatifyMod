{
  "schemaVersion": 1,
  "id": "catify",
  "version": "${version}",
  "name": "Catify",
  "description": "A client-side mod that changes your player model to a cat! Purely visual.",
  "authors": [
    "DaylightDragon"
  ],
  "contact": {
    "sources": "https://github.com/DaylightDragon/CatifyMod"
  },
  "license": "MIT",
  "icon": "assets/catify/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "org.daylight.catify.fabric.CatifyFabric"
    ],
    "client": [
      "org.daylight.catify.fabric.CatifyFabricClient"
    ]
  },
  "mixins": [
    "catify.mixins.json",
    "fabric-catify.mixins.json"
  ],
  "depends": {
    "fabricloader": "*",
    "minecraft": ">=26.1 <26.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {

  }
}
